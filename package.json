  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "cd artifacts/llm-social-simulation && vite --config vite.config.ts --host 0.0.0.0",
    "build": "cd artifacts/llm-social-simulation && vite build --config vite.config.ts",
    "serve": "cd artifacts/llm-social-simulation && vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p artifacts/llm-social-simulation/tsconfig.json --noEmit",
    "validate:map": "cd artifacts/llm-social-simulation && bun scripts/validate-map.ts",
    "validate:render": "cd artifacts/llm-social-simulation && bun scripts/validate-render.ts",
    "validate:spectator": "cd artifacts/llm-social-simulation && bun scripts/validate-spectator.ts",
    "validate:movement": "cd artifacts/llm-social-simulation && bun scripts/validate-movement.ts",
    "validate:touch": "cd artifacts/llm-social-simulation && bun scripts/validate-touch.ts",
    "validate:ai": "cd artifacts/llm-social-simulation && bun scripts/validate-ai.ts",
    "validate:interactions": "cd artifacts/llm-social-simulation && bun scripts/validate-interactions.ts",
    "validate:imposters": "cd artifacts/llm-social-simulation && bun scripts/validate-imposters.ts",
    "validate:walls": "cd artifacts/llm-social-simulation && bun scripts/validate-walls.ts",
    "validate:ui": "cd artifacts/llm-social-simulation && bun scripts/validate-ui.tsx",
    "simulate": "cd artifacts/llm-social-simulation && bun scripts/simulate.ts",
    "verify:llm": "cd artifacts/llm-social-simulation && bun scripts/verify-llm.ts",
    "check": "pnpm run typecheck && pnpm run validate:map && pnpm run validate:movement && pnpm run validate:touch && pnpm run validate:render && pnpm run validate:spectator && pnpm run validate:ui && pnpm run validate:ai && pnpm run validate:interactions && pnpm run validate:imposters && pnpm run validate:walls && pnpm run simulate"
  },
