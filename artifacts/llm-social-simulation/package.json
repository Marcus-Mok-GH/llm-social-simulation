{
  "name": "@workspace/llm-social-simulation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:map": "bun scripts/validate-map.ts",
    "validate:render": "bun scripts/validate-render.ts",
    "validate:movement": "bun scripts/validate-movement.ts",
    "validate:touch": "bun scripts/validate-touch.ts",
    "validate:ai": "bun scripts/validate-ai.ts",
    "validate:interactions": "bun scripts/validate-interactions.ts",
    "validate:imposters": "bun scripts/validate-imposters.ts",
    "validate:ui": "bun scripts/validate-ui.tsx",
    "simulate": "bun scripts/simulate.ts",
    "verify:llm": "bun scripts/verify-llm.ts",
    "check": "pnpm run typecheck && pnpm run validate:map && pnpm run validate:movement && pnpm run validate:touch && pnpm run validate:render && pnpm run validate:ui && pnpm run validate:ai && pnpm run validate:interactions && pnpm run validate:imposters && pnpm run simulate"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "convex": "^1.17.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
